# RYVENO environment configuration
# Copy this file to .env.local and fill in the values you need.
# The storefront runs with zero configuration using its local demo backend.

# --- Supabase (optional) -------------------------------------------------
# Set USE_SUPABASE=true only after running supabase/schema.sql and creating
# the tables. The local-first demo store is used when these are absent.
NEXT_PUBLIC_USE_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only, never expose to browser

# --- Payments (integration-ready) ---------------------------------------
NEXT_PUBLIC_BKASH_ENABLED=false
NEXT_PUBLIC_BKASH_NUMBER=+880 1700-000000
NEXT_PUBLIC_NAGAD_ENABLED=false
NEXT_PUBLIC_NAGAD_NUMBER=+880 1800-000000
NEXT_PUBLIC_SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=   # server-side only
SSLCOMMERZ_ENVIRONMENT=sandbox

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ryveno.com
